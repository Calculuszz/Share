# คัดลอกไฟล์นี้เป็น .env แล้วใส่ key (เอาได้ที่ https://aistudio.google.com/apikey)
# key อยู่ที่ server เท่านั้น ไม่ถูกส่งไปหน้าเว็บ
GEMINI_API_KEY=
# โมเดลที่ใช้อ่านบิล (ค่าเริ่มต้น gemini-3.5-flash-lite: เร็วสุดและอ่านบิลจริงถูก; ไม่ต้องตั้งก็ได้)
# GEMINI_MODEL=gemini-3.5-flash-lite
PORT=3000

# ที่เก็บบิลบน Vercel (Upstash Redis) — ถ้าต่อผ่าน Vercel Marketplace จะถูกใส่ให้เอง
# รันในเครื่องไม่ต้องตั้ง จะเก็บเป็นไฟล์ใน data/bills/ แทน
KV_REST_API_URL=
KV_REST_API_TOKEN=
